# R1 (VyOS) – Core-Router und interne Firewall
# Einfuegen nach: configure
# Danach: commit / save
# Interfaces: eth0 Transit, eth1 Clients, eth2 Server, eth3 frei (Ausbau Netz 50)

set system host-name 'R1'
set system config-management commit-confirm action 'rollback'

set interfaces ethernet eth0 address '10.10.99.2/24'
set interfaces ethernet eth0 description 'Transit zu OPNsense LAN'
set interfaces ethernet eth1 address '10.10.10.1/24'
set interfaces ethernet eth1 description 'Clients - PC1'
set interfaces ethernet eth2 address '10.10.30.1/24'
set interfaces ethernet eth2 description 'Server - SRV-ERP'
set interfaces ethernet eth3 description 'Neues Clientnetz 10.10.50.0/24 - PC2 (noch frei)'

set protocols static route 0.0.0.0/0 next-hop '10.10.99.1'

set system name-server '10.10.99.1'
set system static-host-mapping host-name shop.techtrade.lab inet '10.10.40.14'
set system static-host-mapping host-name erp.techtrade.lab inet '10.10.30.13'
set service dns forwarding listen-address '10.10.10.1'
set service dns forwarding listen-address '10.10.30.1'
set service dns forwarding allow-from '10.10.0.0/16'
set service dns forwarding system

set firewall group network-group NET-CLIENTS network '10.10.10.0/24'
set firewall group address-group SRV-WEB address '10.10.40.14'
set firewall group address-group SRV-ERP address '10.10.30.13'
set firewall group address-group OPNSENSE address '10.10.99.1'
set firewall group port-group PORTS-SHOP port '8080'
set firewall group port-group PORTS-SHOP port '5201'

set firewall ipv4 forward filter default-action 'drop'
set firewall ipv4 forward filter default-log

set firewall ipv4 forward filter rule 10 action 'accept'
set firewall ipv4 forward filter rule 10 state 'established'
set firewall ipv4 forward filter rule 10 state 'related'
set firewall ipv4 forward filter rule 15 action 'drop'
set firewall ipv4 forward filter rule 15 state 'invalid'

set firewall ipv4 forward filter rule 20 description 'Clients -> Shop und Messdienst'
set firewall ipv4 forward filter rule 20 action 'accept'
set firewall ipv4 forward filter rule 20 protocol 'tcp'
set firewall ipv4 forward filter rule 20 source group network-group 'NET-CLIENTS'
set firewall ipv4 forward filter rule 20 destination group address-group 'SRV-WEB'
set firewall ipv4 forward filter rule 20 destination group port-group 'PORTS-SHOP'

set firewall ipv4 forward filter rule 25 description 'Clients -> OPNsense GUI'
set firewall ipv4 forward filter rule 25 action 'accept'
set firewall ipv4 forward filter rule 25 protocol 'tcp'
set firewall ipv4 forward filter rule 25 source group network-group 'NET-CLIENTS'
set firewall ipv4 forward filter rule 25 destination group address-group 'OPNSENSE'
set firewall ipv4 forward filter rule 25 destination port '443'

set firewall ipv4 forward filter rule 30 description 'Ping intern'
set firewall ipv4 forward filter rule 30 action 'accept'
set firewall ipv4 forward filter rule 30 protocol 'icmp'

set firewall ipv4 forward filter rule 40 description 'Shop -> ERP'
set firewall ipv4 forward filter rule 40 action 'accept'
set firewall ipv4 forward filter rule 40 protocol 'tcp'
set firewall ipv4 forward filter rule 40 source group address-group 'SRV-WEB'
set firewall ipv4 forward filter rule 40 destination group address-group 'SRV-ERP'
set firewall ipv4 forward filter rule 40 destination port '9000'

set firewall ipv4 forward filter rule 50 description 'Clients -> Internet'
set firewall ipv4 forward filter rule 50 action 'accept'
set firewall ipv4 forward filter rule 50 source group network-group 'NET-CLIENTS'
set firewall ipv4 forward filter rule 50 destination address '!10.0.0.0/8'

set firewall ipv4 forward filter rule 55 description 'ERP -> Internet (Updates)'
set firewall ipv4 forward filter rule 55 action 'accept'
set firewall ipv4 forward filter rule 55 source group address-group 'SRV-ERP'
set firewall ipv4 forward filter rule 55 destination address '!10.0.0.0/8'

set firewall ipv4 forward filter rule 90 description 'Clients -> ERP gesperrt'
set firewall ipv4 forward filter rule 90 action 'drop'
set firewall ipv4 forward filter rule 90 log
set firewall ipv4 forward filter rule 90 source group network-group 'NET-CLIENTS'
set firewall ipv4 forward filter rule 90 destination group address-group 'SRV-ERP'
